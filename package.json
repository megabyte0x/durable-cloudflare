{
  "name": "nanocode-cloudflare-durable",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-ui.mjs && npm run check",
    "check": "tsc --noEmit && tsc --project tsconfig.ui.json",
    "deploy": "node scripts/deploy.ts",
    "deploy:demo": "node scripts/deploy.ts demo",
    "deploy:demo:raw": "CLOUDFLARE_ACCOUNT_ID=0a39052b0a32ba8c8444345fe21b7595 wrangler deploy --name nanocode-cloudflare-durable --var CHAT_PUBLIC:1 --var CLAUDE_MODEL:claude-haiku-5-5 --var AI_GATEWAY_ID:nanocode-cloudflare-durable --var WORKERS_AI_ACCOUNT_ID:0a39052b0a32ba8c8444345fe21b7595 --domain cloudflare.nanocode.xyz",
    "deploy:raw": "wrangler deploy",
    "dev": "wrangler dev",
    "drill": "node scripts/drill.mjs",
    "dry-run": "wrangler deploy --dry-run --outdir output/deploy",
    "measure": "node scripts/measure-local.mjs"
  },
  "dependencies": {
    "@pierre/highlights": "0.2.0",
    "nanocode-ts": "https://github.com/nanocodexyz/nanocode-ts/releases/download/build-6d58e23/nanocode-ts-6d58e23.tgz",
    "nds": "https://github.com/nanocodexyz/nds/releases/download/build-5454fa8/nds-5454fa8.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zyzz": "0.0.40"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.2",
    "wrangler": "4.151.1"
  }
}
