{
  "name": "nanocode-board",
  "main": "worker/board.ts",
  "compatibility_date": "2026-10-16",
  "minify": true,
  "build": { "command": "cargo build --release --target wasm32-unknown-unknown --manifest-path board/Cargo.toml --target-dir target" },
  "durable_objects": {
    "bindings": [
      { "name": "BOARDS", "class_name": "BoardRoom" },
      { "name": "AGENTS", "class_name": "BoardAgent" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom", "BoardAgent"] }],
  "vars": {
    "ACCESS_TOKEN_SHA256": "",
    "BOARD_LEASE_MS": "60000",
    "BOARD_RENEW_MS": "20000"
  },
  "observability": { "enabled": true }
}
